# 返却デスク（仮称）環境変数の説明。値は入れずにコピーして使う。
# フロントに公開される値（VITE_ 接頭辞）。秘密を入れない。
# demo = Stage A 架空データデモ／pilot = Stage B 試験版（未実装）。アクセス制御の根拠にしない。
VITE_APP_MODE=demo
# Stage B のみ。Supabase プロジェクトURLと publishable key。
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# 以下はサーバー側のみ（Edge Functions／CI secret）。.env.local に書かない・VITE_ を付けない。
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# APP_ORIGIN=
# BACKUP_DESTINATION=
# BACKUP_ENCRYPTION_KEY=
